# ВНИМАНИЕ: домены — заглушки, скопированные по структуре с marin.
# Подставить реальные перед первым `up -d` (Caddy сразу пойдёт за сертификатом).

# www → apex: консолидация хоста (SEO)
www.alyeparusa.mediann.dev {
	redir https://alyeparusa.mediann.dev{uri} permanent
}

alyeparusa.mediann.dev {
	encode gzip zstd
	# Тяжёлая статика: секвенции кадров hero, CMS-медиа (/cms-media — имена
	# контент-хэшированы), иконки — иммутабельный годовой кэш.
	# defer — перезаписать заголовок ПОСЛЕ ответа апстрима (Next ставит max-age=0)
	@heavy path /media/* /cms-media/* /icons/*
	header @heavy {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}
	# OG-обложка может перегенерироваться — сутки, не immutable
	@og path /og-cover.png
	header @og {
		Cache-Control "public, max-age=86400"
		defer
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy client:3000
}

admin.alyeparusa.mediann.dev {
	encode gzip zstd
	header Strict-Transport-Security "max-age=31536000"
	# Служебный хост — вне поисковых индексов
	header X-Robots-Tag "noindex, nofollow"
	respond /robots.txt "User-agent: *
Disallow: /" 200
	reverse_proxy admin:3001
}

api.alyeparusa.mediann.dev {
	encode gzip zstd
	header Strict-Transport-Security "max-age=31536000"
	# Служебный хост — вне поисковых индексов
	header X-Robots-Tag "noindex, nofollow"
	respond /robots.txt "User-agent: *
Disallow: /" 200
	reverse_proxy backend:8000
}
