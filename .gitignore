# ⚠ Репозиторий ПУБЛИЧНЫЙ. Всё, что здесь не исключено, видно всему интернету.

# ── Секреты ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.prod
deploy/.env.prod
*.pem
*.key
id_rsa*

# ── Зависимости и сборки ────────────────────────────────────────────
node_modules/
.next/
out/
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# ── Загруженные пользователем медиа (живут в хранилище, не в коде) ──
backend/media_files/
web/.media-cache/

# ── Исходники видео: 387 МБ, нужны только для пересборки медиа ──────
# Слэш в начале обязателен: без него шаблон вырезал бы одноимённые папки
# на любом уровне — так из сборки уже выпал web/src/infrastructure/content.
# Готовые кадры и ролики лежат в web/public/media и в репозиторий входят.
/materials/

# ── Коммерческие документы: смета, ТЗ заказчику, скриншоты ──────────
# В публичном репозитории им не место.
docs/estimate/
docs/screenshots/
/content/
*.xlsx
*.docx

# ── ОС и редакторы ──────────────────────────────────────────────────
.DS_Store
*.tsbuildinfo
next-env.d.ts
.idea/
.vscode/

# Резервные копии, создаваемые make backup
backups/
