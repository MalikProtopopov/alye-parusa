# Backend — пример переменных окружения (локальный демо)
DATABASE_URL=postgresql+psycopg2://parusa:parusa@localhost:5432/parusa
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Уведомления о заявке (З13: по умолчанию telegram; в демо — лог в консоль)
NOTIFY_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Фичефлаги: выключи ненужный блок — его публичные и админ-роуты пропадут,
# а фронт скроет соответствующую секцию/пункт меню. По умолчанию всё включено.
FEATURE_NEWS=true
FEATURE_FAQ=true
FEATURE_ADVANTAGES=true
FEATURE_PARTNERS=true
FEATURE_TEAM=true
FEATURE_DOCUMENTS=true
FEATURE_CALCULATOR=true
FEATURE_SEO_ADMIN=true

# Демо-учётки админки (создаются на старте)
SEED_SUPERADMIN_EMAIL=admin@alyeparusa.local
SEED_SUPERADMIN_PASSWORD=admin12345
SEED_MANAGER_EMAIL=manager@alyeparusa.local
SEED_MANAGER_PASSWORD=manager12345

# Ссылка «Открыть в админке» в Telegram-уведомлении о заявке
ADMIN_URL=http://localhost:3001
