# Public base URL of the deployed site (used for metadata / canonical / OG).
NEXT_PUBLIC_SITE_URL=https://alyeparusa.example

# API base URL as seen from the visitor's browser (lead form, media links).
NEXT_PUBLIC_API_URL=http://localhost:8000

# API base URL as seen from the Next.js server (SSR/ISR fetches, /cms-media
# rewrite target). Inside docker-compose this is http://backend:8000.
API_URL=http://localhost:8000
